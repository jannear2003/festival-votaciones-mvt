DJANGO_PRODUCTION=True
DJANGO_SECRET_KEY=cambie-esta-clave-en-produccion
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=su-aplicacion.azurewebsites.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://su-aplicacion.azurewebsites.net

DB_ENGINE=postgresql
DB_NAME=festival_votaciones
DB_USER=festival_app
DB_PASSWORD=cambie-esta-contrasena
DB_HOST=servidor-postgresql.postgres.database.azure.com
DB_PORT=5432
DB_SSLMODE=require

GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=600
PORT=8000

SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
