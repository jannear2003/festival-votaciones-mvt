{
"name": "Festival Votaciones Django MVT",
"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
"forwardPorts": [8000],
"portsAttributes": {
"8000": {
"label": "Aplicación Django",
"onAutoForward": "openPreview",
"visibility": "private"
}
},
"postCreateCommand": "pip install -r requirements.txt && python manage.py migrate && python manage.py seed_demo",
"customizations": {
"vscode": {
"extensions": [
"ms-python.python",
"ms-python.vscode-pylance",
"batisteo.vscode-django"
],
"settings": {
"python.defaultInterpreterPath": "/usr/local/bin/python",
"files.exclude": {
"**/__pycache__": true
}
}
}
}
}
